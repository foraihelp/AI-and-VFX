# Copy to .env for local runs. NEVER commit .env (it is git-ignored).
# On GitHub, put secrets under Settings > Secrets and variables > Actions.

# --- Discovery -------------------------------------------------------------
# Optional. Without it the app uses channel RSS feeds only (no search queries).
YOUTUBE_API_KEY=

# --- Email (choose one provider) ------------------------------------------
EMAIL_PROVIDER=resend            # resend | smtp
EMAIL_TO=you@example.com
EMAIL_FROM=Video Digest <digest@example.com>

# Resend
RESEND_API_KEY=

# SMTP (e.g. Gmail: smtp.gmail.com, 587, starttls, with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls           # starttls | ssl | none

# --- Behaviour (all optional; defaults shown) -----------------------------
LOOKBACK_HOURS=48                # normal runs: look this far back
INITIAL_LOOKBACK_HOURS=72        # first run only (no state file history)
SEND_EMPTY=true                  # false = skip the "no new videos" email
DIGEST_TIMEZONE=UTC              # display timezone, e.g. Europe/London
SUMMARIES=description            # description | off
MAX_ITEMS_PER_SOFTWARE=15
INCLUDE_SHORTS=false
